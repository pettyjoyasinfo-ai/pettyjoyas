APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Producción (Hostinger): MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=petty_joyas
DB_USERNAME=root
DB_PASSWORD=
# Para desarrollo rápido se puede usar sqlite: DB_CONNECTION=sqlite

# --- Integraciones (fases siguientes) ---
# Frontend permitido para CORS (Vercel)
FRONTEND_URL=http://localhost:3000

# MercadoPago (Fase 2) — credenciales del cliente en producción
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Developers > Tu integración > Webhooks > Configurar notificaciones. Sin esto,
# la firma X-Signature del webhook no se valida (queda igual funcional, menos seguro).
MP_WEBHOOK_SECRET=

# Datos de transferencia (checkout + POS)
BANK_ALIAS=pettyjoyas.mp
BANK_CBU=
BANK_NAME=Mercado Pago
BANK_HOLDER=Petty Joyas

# WhatsApp de contacto del negocio — se usa como fallback al crear un
# producto nuevo sin whatsapp_url propio (CreateProductAction). Independiente
# de NEXT_PUBLIC_WA_NUMBER del frontend — hay que configurar los dos.
PETTY_WA_NUMBER=

# WhatsApp Cloud API + IA (Fase 6) — ver docs/modules/10-whatsapp-bot.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
ANTHROPIC_API_KEY=

# Chatbot con IA — Groq (gratis). API key desde https://console.groq.com/keys
# (Groq ≠ Grok de xAI). Sin AI_API_KEY el chat cae a un mensaje que deriva a
# WhatsApp. API compatible OpenAI: cambiar de proveedor = solo estas 3 líneas.
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1

# Meta Ads / Conversions API (Fase 5)
META_PIXEL_ID=
META_CAPI_TOKEN=

# Revalidación instantánea del frontend al guardar un producto (evita la
# espera de hasta 60s de la caché ISR). Si se dejan vacías, se usan los
# valores por defecto ya cargados en config/services.php.
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=

# Google OAuth (mismo Client ID que el frontend; valida el ID token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Envío de correos (Gmail SMTP con App Password) ──
# Generar App Password en https://myaccount.google.com/apppasswords (cuenta con 2FA).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Petty Joyas"

# Correo del administrador/vendedor que recibe los avisos internos.
MAIL_ADMIN_ADDRESS=
MAIL_ADMIN_NAME="Petty Joyas"

# MODO PRUEBA: si tiene valor, TODOS los correos (clientes y admin) se redirigen
# a esa casilla. En producción dejar VACÍO para que lleguen a destinatarios reales.
MAIL_TEST_REDIRECT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
